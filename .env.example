# ServiceNow Configuration
SERVICENOW_INSTANCE_URL=https://dev317531.service-now.com/
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=%-pywADI9J1d

# LLM Provider (choose one)
# OPENAI_API_KEY=sk-your-openai-key
GOOGLE_API_KEY=AIzaSyDOR-2zybyqwK1iFu0qfsL-jQoNrHC5J-Q

# SSO Configuration
SSO_SIGNIN_URL=https://your-sso-portal.com/login

# Agent Configuration
TICKET_CHECK_INTERVAL=300000
AUTO_RESOLVE_TICKETS=false

# Keywords to detect access issues (comma-separated)
ACCESS_KEYWORDS=access,login,sign in,authentication,SSO,password,credentials

# Microsoft Teams Integration (Optional)
# To enable Teams notifications, set up an Azure AD app and fill in these values

# RAG Configuration
RAG_ENABLED=true
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_SIMILAR_CASES=5
RAG_EMBEDDING_MODEL=text-embedding-3-small

# API Server
API_PORT=3000
API_HOST=localhost
ENABLE_CORS=true

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SESSION_SECRET=change-this-to-a-random-secret-in-production

# Knowledge Base
KB_STORAGE_TYPE=json
KB_FILE_PATH=./data/knowledge-base.json
KB_PRIORITY_WEIGHT=2.0

# ServiceNow Ticket Monitor
TICKET_MONITOR_ENABLED=true
TICKET_CHECK_INTERVAL=60000

# Vector Database Configuration - Qdrant Cloud
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION_PREFIX=
VECTOR_DB_BATCH_SIZE=50
ENABLE_SERVICENOW_EMBEDDING=true
PROCESSED_TICKETS_CACHE=./data/processed-tickets.json
